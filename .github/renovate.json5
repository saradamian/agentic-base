{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on monday"] },
  "enabledManagers": ["pep621", "pip_requirements"],
  "labels": ["dependencies"],
  "packageRules": [
    { "matchUpdateTypes": ["patch"], "automerge": false },
    // The SDK pins the semantic conventions of its own release, and the instrumentation pins both.
    // Updated one at a time the lock cannot resolve, so they move together. Two of the four are
    // released as 0.NNb0, which Renovate reads as unstable and leaves out unless told otherwise.
    { "matchPackageNames": ["/^opentelemetry-/"], "groupName": "opentelemetry", "ignoreUnstable": false }
  ]
}
